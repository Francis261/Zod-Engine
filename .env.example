# External AI provider config
# Copy to .env.local and fill values.

# Set this to use the Gemini proxy path in /api/ai-call
GEMINI_API_KEY=

# Optional backend model override used when /api/query does not pass model
GEMINI_MODEL=gemini-2.5-flash

# Optional frontend defaults
NEXT_PUBLIC_DEFAULT_AI_PROVIDER=stub
NEXT_PUBLIC_DEFAULT_GEMINI_MODEL=gemini-2.5-flash
